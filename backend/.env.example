# Copy to .env and fill in your own values. Never commit .env.

# Postgres connection string (Supabase works). Run sql/schema.sql against it first.
DATABASE_URL=postgresql://postgres:your_password@db.your-project-ref.supabase.co:5432/postgres

# HTTP + Socket.IO port.
PORT=3000

# Comma-separated list of allowed browser origins. Leave empty to allow any origin.
FRONTEND_ORIGIN=http://localhost:8081

# n8n "Mentor-Dispatch" production webhook URL. If empty, failed check-ins are
# still logged and the student is locked, but no mentor email is sent.
N8N_WEBHOOK_URL=https://your-n8n-instance/webhook/mentor-dispatch

# Shared secret: sent to n8n on the webhook call, and accepted from n8n in the
# x-n8n-secret header on /assign-intervention, /complete-intervention and
# /api/interventions.
N8N_SECRET=change_me_shared_secret_with_n8n

# Default mentor address passed to n8n when the check-in doesn't include one.
MENTOR_EMAIL=mentor@example.com

# Public URL of the Expo web app; passed to n8n so the email links to
# <APP_URL>/assign-intervention. n8n can also hard-code this instead.
APP_URL=http://localhost:8081

# Clerk secret key, used to verify the session token the app sends as
# "Authorization: Bearer <token>". Without it only x-n8n-secret is accepted.
CLERK_SECRET_KEY=sk_test_your_secret_key
# Optional: Clerk JWT public key (PEM) for networkless token verification.
CLERK_JWT_KEY=

# Development only: accept unauthenticated requests on protected endpoints.
# Ignored when NODE_ENV=production.
ALLOW_DEV_AUTH_BYPASS=false
NODE_ENV=development
